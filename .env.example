# ============================================
# Activity Hub 環境変数(すべて省略可能)
# 値を設定した行だけ有効になります。
# 編集後はサーバーを再起動してください。
# ============================================

# ---- GitHub(任意) ----
# 未設定でも動作しますが、APIレート制限が 60回/時 です。
# トークン設定で 5,000回/時 に緩和されます。
# 作成: https://github.com/settings/tokens (Fine-grained / classic どちらでもOK・権限不要)
GITHUB_TOKEN=

# ---- Reddit(必須: Redditを表示する場合) ----
# 作成: https://www.reddit.com/prefs/apps → 「create an app」→ 種類 "script"
#  app 名下の14文字が CLIENT_ID、secret が CLIENT_SECRET
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ---- YouTube(任意) ----
# 未設定でも RSS フィード経由で最近の動画を取得します(環境により失敗することあり)。
# 作成: https://console.cloud.google.com → 「YouTube Data API v3」を有効化 → 認証情報 → APIキー
YOUTUBE_API_KEY=

# ---- X / Twitter(必須: Xを表示する場合) ----
# 作成: https://developer.x.com → Projects & Apps → 該当App → Keys and tokens → Bearer Token
#  ※ Free プランは読み取り枠が非常に少ない点に注意
X_BEARER_TOKEN=

# ---- Google Calendar(必須: カレンダーを表示する場合) ----
# 方法A) サービスアカウント(推奨・簡単)
#   Google Cloud Console でサービスアカウントを作成 → JSONキーをダウンロード →
#   このフォルダに service-account.json として置き、下記にファイル名を設定 →
#   見たいカレンダーを、サービスアカウントのメール(…@….iam.gserviceaccount.com)に「予定の表示」権限で共有
GOOGLE_APPLICATION_CREDENTIALS=

# 方法B) OAuth リフレッシュトークン
#   Google Cloud Console で OAuth クライアント(デスクトップアプリ)を作成し、
#   calendar.readonly スコープで取得したリフレッシュトークンを設定
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---- サーバーポート(任意・既定 3000) ----
# ⚠️ Railway では PORT が自動注入されるため、設定しないでください(空のままにする)
PORT=3000

# ============================================
# デプロイ時(Railway / Docker / VPS など)
# ============================================

# ---- 設定の永続化(任意) ----
# config.json(設定画面からの変更)の保存先ディレクトリ。
# Railway: サービスに Volume を /data にマウントし、DATA_DIR=/data を設定すると
#          再デプロイ後も設定が維持されます(未設定の場合は再デプロイで初期値に戻ります)。
DATA_DIR=

# ---- Basic 認証(任意) ----
# 両方設定すると、公開 URL 全体がユーザー名/パスワード保護されます。
# (ローカル利用では空のままで OK)
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
